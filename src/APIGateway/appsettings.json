{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "FintechAuthServer",
    "Audience": "FintechApiClient",
    "Key": "YourSuperSecretKeyqqwertyuioppooooooooooooooiyuuasdfghjkiyjuhrrgrefeefgeewgrgehtwhwhth"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth/{**catch-all}"
          }
        ]
      },
      "accounts-route": {
        "ClusterId": "accounts-cluster",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/accounts/{**catch-all}"
          }
        ]
      },
      "transactions-route": {
        "ClusterId": "transactions-cluster",
        "Match": {
          "Path": "/api/transactions/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/transactions/{**catch-all}"
          }
        ]
      },
      "wallets-route": {
        "ClusterId": "wallets-cluster",
        "Match": {
          "Path": "/api/wallets/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/wallets/{**catch-all}"
          }
        ]
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/notifications/{**catch-all}"
          }
        ]
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/v1/Payments/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5258"
          }
        }
      },
      "accounts-cluster": {
        "Destinations": {
          "accounts-destination": {
            "Address": "http://localhost:5018"
          }
        }
      },
      "transactions-cluster": {
        "Destinations": {
          "transactions-destination": {
            "Address": "http://localhost:5050"
          }
        }
      },
      "wallets-cluster": {
        "Destinations": {
          "wallets-destination": {
            "Address": "http://localhost:5219"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notifications-destination": {
            "Address": "http://localhost:5132"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "payments-destination": {
            "Address": "http://localhost:5150"
          }
        }
      }
    }
  }
}
